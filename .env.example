# Copy this file to .env and fill in the blanks:
#
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows / PowerShell)
#
# The defaults below are enough to run the whole system locally.
# No API key is required — see "Generation" for what happens without one.

# ---- Database ----------------------------------------------------------
# Matches docker-compose.yml. Host port is 5433 to avoid colliding with a
# Postgres already listening on 5432.
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# ---- Embeddings --------------------------------------------------------
# Fully local, no API key. The fp32 ONNX weights (~127 MB) download once on
# and is cached in .models/.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ---- Generation --------------------------------------------------------
# Optional. With LLM_PROVIDER=none, or with gemini selected but no API key
# present, the app falls back to extractive mode: it returns the ranked
# passages with citations instead of a written answer. It never hard-fails
# on a missing key.
LLM_PROVIDER=none              # gemini | ollama | none
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# ---- Auth --------------------------------------------------------------
# Generate a secret with (works on every platform, no openssl needed):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---- Corpus ------------------------------------------------------------
# The synthetic corpus is committed under data/corpus.
CORPUS_PATH=./data/corpus

# ---- MCP ---------------------------------------------------------------
MCP_HTTP_PORT=3333
MCP_BEARER_TOKEN=dev-token-change-me
